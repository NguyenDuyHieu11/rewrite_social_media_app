# ---- Shared ----
APP_ENV=dev
LOG_LEVEL=debug

# ---- Postgres ----
POSTGRES_DSN=postgres://app:app@localhost:5432/social?sslmode=disable

# ---- Redis ----
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- Auth ----
JWT_SECRET=change-me-in-production-please-32-bytes-minimum
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ---- Gateway ----
GATEWAY_ID=gateway-1
GATEWAY_ADDR=:8081

# ---- Dispatcher ----
DISPATCHER_ADDR=:8080
